# ==============================================================================
# TRIAGE-MAIL — DEVELOPMENT & OPTIONAL TEST CONFIGURATION
# ==============================================================================
# Copy this file to `.env` for local development overrides:
#   cp .env.example .env
#
# SECURITY INVARIANT [P0]:
# - NEVER commit `.env`, real OAuth `client_secret`, access tokens, or personal
#   email addresses to Git.
# - Runtime user credentials and DB encryption keys are stored strictly in the
#   OS Keyring (`crates/vault` via `keyring` + `argon2`), NOT in `.env` files.
# ==============================================================================

# [Logging & Diagnostics]
RUST_LOG=info,triage_mail=debug,mail_engine=info,storage=info

# [Local Database Path Override (Development Only)]
# Defaults to OS standard app data dir when unset
TRIAGE_DB_PATH=./.agent/scratch/dev-triage.db

# [Tier 2 Local Embeddings Model]
# Quantized ONNX model executed locally on CPU (`all-MiniLM-L6-v2` or `bge-small-en-v1.5`)
TRIAGE_EMBEDDING_MODEL=all-MiniLM-L6-v2

# [Tier 3 Optional Local LLM (Ollama)]
# Used only when on-demand summarization is triggered by the user
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b

# [Proton Mail Bridge Local Loopback Defaults]
PROTON_BRIDGE_HOST=127.0.0.1
PROTON_BRIDGE_PORT=1143
