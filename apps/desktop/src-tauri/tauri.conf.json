{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "triage-mail",
  "version": "0.1.5",
  "identifier": "org.yesandbox.triagemail",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "triage-mail",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "shortDescription": "100% Local-First Email Aggregator & Triage Engine",
    "longDescription": "100% Local-First, Provider-Agnostic, Open-Source Email Aggregator & Triage Engine built with Rust, Tauri v2, SQLite, and SvelteKit 5.",
    "category": "Productivity",
    "copyright": "AGPL-3.0-only",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}
